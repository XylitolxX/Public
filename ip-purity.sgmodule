#!name=IP 纯净度
#!desc=直连和节点的 IP 纯净度，分成两个面板，各自显示自己的风险图标。
#!category=网络检测
#!arguments=Proxy:Proxy,MarkIP:true
#!arguments-desc=Proxy: 要检测的策略组或节点，默认 Proxy（支持花体字名称） | MarkIP: IP 打码(true/false)，默认 true
#!system=ios

[Panel]
IP-Pure-Direct = script-name=IP-Pure-Direct, title=IP 纯净度 · 直连, content=刷新中…, style=info, update-interval=300
IP-Pure-Proxy = script-name=IP-Pure-Proxy, title=IP 纯净度 · 节点, content=刷新中…, style=info, update-interval=300

[Script]
IP-Pure-Direct = type=generic, timeout=15, argument=Proxy={{{Proxy}}}&MarkIP={{{MarkIP}}}&Mode=direct, script-path=https://raw.githubusercontent.com/XylitolxX/Public/main/ip_purity.js?v=6, script-update-interval=3600
IP-Pure-Proxy = type=generic, timeout=20, argument=Proxy={{{Proxy}}}&MarkIP={{{MarkIP}}}&Mode=proxy, script-path=https://raw.githubusercontent.com/XylitolxX/Public/main/ip_purity.js?v=6, script-update-interval=3600
