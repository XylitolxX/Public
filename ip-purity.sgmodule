#!name=IP 纯净度
#!desc=节点 IP 纯净度检测，请先在参数内选择策略组或节点。
#!category=网络检测
#!arguments=Proxy:DIRECT,MarkIP:true
#!arguments-desc=Proxy: 选择策略组或节点，默认 DIRECT | MarkIP: IP 打码(true/false)，默认 true
#!system=ios

[Panel]
IP-Pure = script-name=IP-Pure, title=IP 纯净度, content=刷新中…, style=info, update-interval=300

[Script]
IP-Pure = type=generic, timeout=10, argument=Proxy={{{Proxy}}}&MarkIP={{{MarkIP}}}, script-path=https://raw.githubusercontent.com/XylitolxX/Public/main/ip_purity.js?v=3, script-update-interval=3600
