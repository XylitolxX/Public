#!name=𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒
#!desc=快速清除Surge的DNS缓存
#!category=面板模块
#!arguments=TITLE:𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒,ICON:cube,COLOR:#AFE59A
#!arguments-desc=[参数设置]\n\n⓵ TITLE: 自定义面板标题（默认就是 𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒）\n\n⓶ ICON: 自定义面板图标,需为有效的SFSymbolName\n⓷ COLOR: 自定义图标颜色,需为颜色的HEX编码
# 更新日期：2025.11.14
# 版本：3.2.1

[Panel]
𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒 = script-name=𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒,update-interval=600

[Script]
𝐅𝐥𝐮𝐬𝐡 | 𝐃𝐍𝐒 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/XylitolxX/Public/main/FlushDNS.js?v=1,argument=title={{{TITLE}}}&icon=pawprint&color={{{COLOR}}}&server=false
